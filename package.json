{
  "name": "finger-tracking-game",
  "private": true,
  "version": "0.1.0",
  "description": "A privacy-minded, camera-powered collection of motion games and creative experiments.",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "test": "node --test",
    "test:ci": "node --test --test-reporter=spec",
    "audit": "npm audit --audit-level=high",
    "check": "npm run test:ci && npm run build && npm run audit",
    "symphony": "bash scripts/run-symphony-local.sh",
    "preview": "vite preview"
  },
  "dependencies": {
    "@tensorflow-models/hand-pose-detection": "^2.0.0",
    "@tensorflow-models/pose-detection": "^2.1.3",
    "@tensorflow/tfjs-backend-cpu": "^4.22.0",
    "@tensorflow/tfjs-backend-webgl": "^4.0.0",
    "@tensorflow/tfjs-core": "^4.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.2.0",
    "vite": "^7.3.6"
  },
  "overrides": {
    "@tensorflow-models/hand-pose-detection": {
      "rimraf": "^6.1.3"
    },
    "@tensorflow-models/pose-detection": {
      "rimraf": "^6.1.3"
    }
  }
}
